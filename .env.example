# Copy this file to .env and fill in your values
# BOT_TOKEN dan MONGODB_URI wajib diisi; ADMIN_ID diperlukan untuk akses admin.
# Isi konfigurasi integrasi yang digunakan dengan nilai milik Anda sendiri.
# Pengaturan BotConfig/SmsConfig disimpan di MongoDB; perubahan .env tidak selalu
# menimpa pengaturan yang sudah tersimpan. Gunakan panel admin untuk mengubahnya.

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/grammy-bot
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/grammy-bot
MONGODB_URI=mongodb://localhost:27017/grammy-bot
# Menggantikan nama database di URI; default runtime bot: danka-telegram.
# Untuk instalasi lama, pertahankan nama database yang sudah digunakan.
DATABASE_NAME=danka-telegram

# ── Admin ──────────────────────────────────────────────────────────────────────
# Telegram user ID(s) of the admin(s).
# Can specify a single ID or multiple IDs separated by comma, space, or semicolon:
# Example: ADMIN_ID=123456789,987654321,11223344
ADMIN_ID=your_telegram_numeric_id_here

# ── Telegram Bot Rental SaaS ─────────────────────────────────────────────────
# Jalankan migrasi tenant (dry-run dahulu) sebelum menyalakan versi ini.
# false: hanya bot platform; true: rental, scheduler, serta /sewa dan entri
# self-service di Catalog bot platform. Rental self-service menunggu pembayaran saat offline.
RENTAL_ENABLED=false
# Kunci AES-256-GCM: 32 byte acak, dikodekan 64 karakter hex atau base64.
# Wajib untuk rental. Simpan backup kunci terpisah; kehilangan kunci membuat
# token/credential renter tidak dapat didekripsi. Jangan ganti tanpa migrasi.
CREDENTIAL_ENCRYPTION_KEY=
# Provisioning CLI saja. Isi secara privat saat membuat rental, lalu kosongkan.
RENTAL_BOT_TOKEN=
# Opsional: relay pembayaran HMAC; 0 mematikan HTTP server (polling tetap aktif).
# Bind selalu 127.0.0.1. Gunakan reverse proxy HTTPS untuk akses eksternal.
RENTAL_WEBHOOK_PORT=0
RENTAL_WEBHOOK_SECRET=

# ── Cloudflare Email Routing ──────────────────────────────────────────────────
# Kredensial Cloudflare API untuk pembuatan email routing forwarder otomatis.
# Global API Key memakai CF_EMAIL. Untuk API Token, gunakan nilai "Bearer <token>".
# Alias: CF_API_KEY jika CF_GLOBAL_API_KEY kosong;
# CF_DESTINATION_EMAIL jika CF_DEST_EMAIL kosong.
CF_EMAIL=your_cloudflare_email@example.com
CF_GLOBAL_API_KEY=your_cloudflare_api_key_or_token
CF_DEST_EMAIL=your_destination_email@example.com

# ── SMSBower / OTP SMS ────────────────────────────────────────────────────────
# Get your key from: https://smsbower.page/
SMSBOWER_API_KEY=your_smsbower_api_key_here
OTP_ENABLED=true

# ── Pembayaran QRIS / GoPay Merchant ──────────────────────────────────────────
# Diperlukan untuk top-up saldo dan pembelian via QRIS.
# Isi payload QRIS statis ATAU sediakan gambar QRIS milik merchant Anda.
# QRIS_STATIC_PAYLOAD diprioritaskan; kosongkan untuk menggunakan QRIS_IMAGE_PATH.
QRIS_STATIC_PAYLOAD=
QRIS_IMAGE_PATH=./qris-static.png
GOPAY_MERCHANT_ID=
GOJEK_EMAIL=
GOJEK_PASSWORD=
# Alternatif nama kredensial: dipakai jika variabel GOJEK terkait kosong.
# GOBIZ_EMAIL=
# GOBIZ_PASSWORD=

# ── Wajib Join Channel (Force Subscription) ──────────────────────────────────
# Channel/grup wajib join sebelum user bisa menggunakan bot.
# CATATAN: Bot HARUS menjadi Administrator di channel ini agar dapat mengecek status member.
# Format channel: @username atau ID numerik -100...; kosongkan bila tidak digunakan.
# Link channel @username dapat dibuat otomatis; isi invite link untuk channel privat.
FORCE_SUB_CHANNEL=@yourchannel
FORCE_SUB_LINK=https://t.me/yourchannel
FORCE_SUB_NAME=Official Channel
FORCE_SUB_ENABLED=true

# ── Testimoni Transaksi Channel ──────────────────────────────────────────────
# Channel tempat bot otomatis memposting bukti transaksi / testimoni setiap kali ada pembelian.
# CATATAN: Bot HARUS menjadi Administrator di channel ini dengan izin Post Messages (Kirim Pesan).
TESTIMONIAL_CHANNEL=@yourtestichannel
TESTIMONIAL_LINK=https://t.me/yourtestichannel
TESTIMONIAL_ENABLED=true

# ── Activity & Audit Log Channel ──────────────────────────────────────────────
# Channel tempat bot otomatis mencatat log audit (user register, top-up, beli produk, sewa OTP).
# CATATAN: Bot HARUS menjadi Administrator di channel ini dengan izin Post Messages (Kirim Pesan).
LOG_CHANNEL=@yourlogchannel
LOG_CHANNEL_LINK=https://t.me/yourlogchannel
LOG_CHANNEL_ENABLED=true

# ── Security Alert Channel ────────────────────────────────────────────────────
# Channel privat admin untuk notifikasi keamanan / anti-fraud.
# Bot harus menjadi Administrator dengan izin Post Messages (Kirim Pesan).
# Kosongkan channel bila tidak digunakan; alias channel: SECURITY_CHANNEL.
SECURITY_ALERT_CHANNEL=
SECURITY_ALERT_CHANNEL_LINK=
SECURITY_ALERT_CHANNEL_ENABLED=true

# ── OTP Channel Forwarder (PayPal, Netflix & Discord via IMAP) ────────────────
# Channel tempat bot otomatis memposting kode OTP PayPal, Netflix & Discord dari email IMAP.
# CATATAN: Bot HARUS menjadi Administrator di channel ini dengan izin Post Messages (Kirim Pesan).
OTP_PAYPAL_CHANNEL=@yourpaypalotpchannel
OTP_PAYPAL_CHANNEL_LINK=https://t.me/yourpaypalotpchannel
OTP_PAYPAL_CHANNEL_ENABLED=true

OTP_NETFLIX_CHANNEL=@yournetflixotpchannel
OTP_NETFLIX_CHANNEL_LINK=https://t.me/yournetflixotpchannel
OTP_NETFLIX_CHANNEL_ENABLED=true

OTP_DISCORD_CHANNEL=@yourdiscordotpchannel
OTP_DISCORD_CHANNEL_LINK=https://t.me/yourdiscordotpchannel
OTP_DISCORD_CHANNEL_ENABLED=true

# ── IMAP Email Listener Configuration ─────────────────────────────────────────
# Kredensial server email IMAP untuk memantau email OTP masuk secara real-time.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
# Gunakan App Password untuk Gmail; alias IMAP_PASSWORD jika IMAP_PASS kosong.
IMAP_PASS=your_app_password_here
IMAP_MAILBOX=INBOX
# Fallback alamat pengirim bila email tidak memiliki From, bukan filter sender.
IMAP_TARGET_SENDER=service@intl.paypal.com
IMAP_ENABLED=true

# ── WhatsApp Bot Configuration (Baileys) ──────────────────────────────────────
# Aktifkan WhatsApp Bot secara bersamaan dengan Telegram Bot (Dual-Platform)
# WHATSAPP_PAIRING_PHONE yang terisi juga mengaktifkan bot walau WHATSAPP_ENABLED=false.
# Untuk menonaktifkan WhatsApp, set false DAN kosongkan WHATSAPP_PAIRING_PHONE.
WHATSAPP_ENABLED=false
# Masukkan nomor bot (format internasional tanpa +, e.g. 6281234567890) untuk menggunakan Pairing Code (8-digit).
# Kosongkan dan set WHATSAPP_ENABLED=true untuk scan QR Code di terminal.
WHATSAPP_PAIRING_PHONE=
# Folder tempat menyimpan sesi login WhatsApp (multi-file auth state)
WHATSAPP_AUTH_DIR=./auth_baileys
# Nomor admin WhatsApp untuk .stats dan .addsaldo (pemisah: koma, spasi, atau titik koma).
WHATSAPP_ADMIN_NUMBERS=6281234567890,6289876543210

# ── Alias Channel untuk Konfigurasi Lama ──────────────────────────────────────
# Gunakan nama utama di atas; alias string dipakai bila nama utama kosong.
# TESTIMONIAL_CHANNEL: TESTI_CHANNEL_ID, lalu CHANNEL_TESTIMONI.
# LOG_CHANNEL: AUDIT_CHANNEL, lalu CHANNEL_LOG.
# OTP_PAYPAL_CHANNEL: OTP_CHANNEL, lalu CHANNEL_OTP.
# OTP_PAYPAL_CHANNEL_LINK: OTP_CHANNEL_LINK.
# OTP_NETFLIX_CHANNEL / _LINK: NETFLIX_OTP_CHANNEL / NETFLIX_OTP_CHANNEL_LINK.
# OTP_DISCORD_CHANNEL / _LINK: DISCORD_OTP_CHANNEL / DISCORD_OTP_CHANNEL_LINK.
# Toggle alias OTP_CHANNEL_ENABLED, NETFLIX_OTP_CHANNEL_ENABLED, dan
# DISCORD_OTP_CHANNEL_ENABLED tetap menonaktifkan channel terkait jika bernilai false,
# meskipun toggle utama bernilai true.
