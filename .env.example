# Copy this file to .env and fill in your values

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/grammy-bot
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/grammy-bot
MONGODB_URI=mongodb://localhost:27017/grammy-bot
DATABASE_NAME=telegram-danka

# ── SMSBower ──────────────────────────────────────────────────────────────────
# Get your key from: https://smsbower.page/
SMSBOWER_API_KEY=your_smsbower_api_key_here